# Cloudflare Zero Trust tunnel token; keep the real token in .env only.
CLOUDFLARE_TUNNEL_TOKEN=

# Public hostname configured for the tunnel in Cloudflare.
PUBLIC_ORIGIN=https://weather.angelikafarm.com

# Optional: the local-only Nginx listener (Cloudflare reaches it over Docker's network).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
